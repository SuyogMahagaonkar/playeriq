# =========================================================================
# PlayerIQ — Local Environment Variables Configuration Template
# Copy this file to a new file named '.env' and fill in your actual keys.
# Keep the '.env' file secret. Do NOT commit it to Git.
# =========================================================================

# 1. SMTP Transporter Credentials (e.g. Resend)
SMTP_HOST="smtp.resend.com"
SMTP_PORT="465"
SMTP_USER="resend"
SMTP_PASS="your_resend_api_key_here"
SMTP_FROM="PlayerIQ <onboarding@resend.dev>"

# 2. Server Configuration
PORT=8788
FFMPEG_PATH="ffmpeg"
